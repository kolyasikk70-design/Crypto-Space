# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=@your_channel_username_or_id
DRY_RUN=true

# LLM API Configuration (OpenAI, Gemini, or compatible proxy)
